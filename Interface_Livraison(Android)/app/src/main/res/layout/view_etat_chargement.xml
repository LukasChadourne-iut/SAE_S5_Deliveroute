<?xml version="1.0" encoding="utf-8"?>
<!-- Superposition affichée pendant un appel API (Volley) ou en cas d’erreur réseau.
     Chargement : progressEtat visible, btnReessayer masqué.
     Erreur : progressEtat masqué, tvMessageEtat = message d’erreur, btnReessayer visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/etatChargement"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:visibility="gone"
    tools:visibility="visible">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressEtat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/tvMessageEtat"
        style="@style/Texte.Secondaire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/etat_chargement"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReessayer"
        style="@style/Bouton.Secondaire"
        android:layout_width="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/btn_reessayer"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
