<?xml version="1.0" encoding="utf-8"?>
<!-- Écran « Colis » : liste des colis à charger, triés par masse décroissante -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Texte.SurTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/colis_sur_titre" />

        <TextView
            android:id="@+id/tvNbColis"
            style="@style/Texte.GrandTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="4 colis" />

        <TextView
            android:id="@+id/tvPoidsTotal"
            style="@style/Texte.Secondaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Poids total · 2 045 kg · 3 clients" />

        <LinearLayout
            style="@style/Bandeau"
            android:layout_marginTop="14dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_boite"
                app:tint="@color/vert_texte" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Texte.Gras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ordre_controle"
                    android:textColor="@color/vert_texte" />

                <TextView
                    style="@style/Texte.Secondaire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ordre_controle_aide"
                    android:textColor="@color/vert_texte" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coche"
                app:tint="@color/vert_texte" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Carte"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvColis"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="4"
                tools:listitem="@layout/item_colis" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <include layout="@layout/view_etat_chargement" />

</FrameLayout>
