<?xml version="1.0" encoding="utf-8"?>
<!-- Validation d’un bon de livraison : récapitulatif, signature du client, envoi électronique -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollSignature"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <TextView
                    style="@style/Texte.SurTitre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bon_titre" />

                <TextView
                    android:id="@+id/tvNumeroBonSignature"
                    style="@style/Texte.GrandTitre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="BL-2026-0842" />

                <!-- Destinataire -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Carte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvClientBon"
                            style="@style/Texte.Gras"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Nord Technique" />

                        <TextView
                            android:id="@+id/tvAdresseBon"
                            style="@style/Texte.Secondaire"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            app:drawableStartCompat="@drawable/ic_lieu"
                            app:drawableTint="@color/gris_icone"
                            tools:text="12 rue du Port, 67170 Brumath" />

                        <TextView
                            android:id="@+id/tvHeureBon"
                            style="@style/Texte.Secondaire"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:drawablePadding="6dp"
                            android:gravity="center_vertical"
                            app:drawableStartCompat="@drawable/ic_horloge"
                            app:drawableTint="@color/gris_icone"
                            tools:text="Jeudi 12 décembre · 09:05" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Colis concernés par ce bon (item_colis) -->
                <TextView
                    style="@style/Texte.Section"
                    android:text="@string/colis_livres" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Carte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvColisBon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_colis" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbBonEtat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/recu_bon_etat"
                    app:buttonTint="@color/vert_fonce" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNomSignataire"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/nom_signataire"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/vert_fonce">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNomSignataire"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName|textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Zone de signature -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Texte.Gras"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/zone_signature" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEffacerSignature"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_effacer"
                        android:textColor="@color/vert_texte" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_zone_signature"
                    android:padding="2dp">

                    <fr.tgv.livraison.ui.view.SignatureView
                        android:id="@+id/signatureView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/zone_signature" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvErreurSignature"
                    style="@style/Texte.Secondaire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/rouge_erreur"
                    android:visibility="gone"
                    tools:text="La signature du client est obligatoire."
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Colis non livré (client absent / refus) : ouvre bottom_sheet_non_livre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNonLivre"
                style="@style/Bouton.Secondaire"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_non_livre"
                android:textColor="@color/rouge_erreur"
                app:icon="@drawable/ic_croix"
                app:iconTint="@color/rouge_erreur" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnValiderBon"
                style="@style/Bouton.Principal"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:text="@string/btn_valider_envoyer"
                app:icon="@drawable/ic_signature" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_etat_chargement" />

</FrameLayout>
