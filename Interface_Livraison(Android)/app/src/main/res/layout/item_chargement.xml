<?xml version="1.0" encoding="utf-8"?>
<!-- Une ligne de l’ordre de chargement (1 = chargé en premier, en bas de la pile) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Carte"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/tvOrdreChargement"
            style="@style/Numero"
            tools:text="1" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_colis"
            app:tint="@color/vert_texte" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIdColisChargement"
                style="@style/Texte.Gras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="COL-038" />

            <TextView
                android:id="@+id/tvClientChargement"
                style="@style/Texte.Secondaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Atelier Mécaflex · arrêt 3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPoidsChargement"
            style="@style/Texte.Gras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="680 kg" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
