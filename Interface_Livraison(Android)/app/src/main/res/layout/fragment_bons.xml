<?xml version="1.0" encoding="utf-8"?>
<!-- Écran « Bons » : liste des bons de livraison de la tournée -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <TextView
            style="@style/Texte.SurTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bons_sur_titre" />

        <TextView
            style="@style/Texte.GrandTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bons_titre" />

        <TextView
            android:id="@+id/tvResumeBons"
            style="@style/Texte.Secondaire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="1 signé · 3 en attente" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBons"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_bon" />

        <LinearLayout
            style="@style/Bandeau"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_signature"
                app:tint="@color/vert_texte" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Texte.Gras"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/signature_aide_titre"
                    android:textColor="@color/vert_texte" />

                <TextView
                    style="@style/Texte.Secondaire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/signature_aide"
                    android:textColor="@color/vert_texte" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_etat_chargement" />

</FrameLayout>
