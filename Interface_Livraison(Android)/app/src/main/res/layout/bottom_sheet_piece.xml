<?xml version="1.0" encoding="utf-8"?>
<!-- Fiche d’une pièce (BottomSheetDialogFragment) : caractéristiques + client associé -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanc"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texte.Secondaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/piece" />

            <TextView
                android:id="@+id/tvNumeroPieceFiche"
                style="@style/Texte.GrandTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="P-881" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEtatPieceFiche"
            style="@style/Badge"
            android:backgroundTint="@color/vert_statut_fond"
            android:textColor="@color/vert_statut"
            tools:text="Fabriquée" />
    </LinearLayout>

    <TextView
        style="@style/Texte.Section"
        android:text="@string/caracteristiques" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:useDefaultMargins="true">

        <TextView
            style="@style/Texte.Secondaire"
            android:text="@string/poids" />

        <TextView
            android:id="@+id/tvPoidsPieceFiche"
            style="@style/Texte.Gras"
            android:layout_gravity="end"
            tools:text="240 kg" />

        <TextView
            style="@style/Texte.Secondaire"
            android:text="@string/commande" />

        <TextView
            android:id="@+id/tvCommandePieceFiche"
            style="@style/Texte.Gras"
            android:layout_gravity="end"
            tools:text="CMD-2481" />

        <TextView
            style="@style/Texte.Secondaire"
            android:text="@string/date_prevue" />

        <TextView
            android:id="@+id/tvDatePieceFiche"
            style="@style/Texte.Gras"
            android:layout_gravity="end"
            tools:text="12/12/2026" />

        <TextView
            style="@style/Texte.Secondaire"
            android:text="@string/nav_colis" />

        <TextView
            android:id="@+id/tvColisPieceFiche"
            style="@style/Texte.Gras"
            android:layout_gravity="end"
            tools:text="COL-038" />
    </GridLayout>

    <TextView
        style="@style/Texte.Section"
        android:text="@string/client" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Carte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvClientPieceFiche"
                style="@style/Texte.Gras"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Atelier Mécaflex" />

            <TextView
                android:id="@+id/tvContactPieceFiche"
                style="@style/Texte.Secondaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Julie Meyer · 03 88 33 12 40" />

            <TextView
                android:id="@+id/tvAdressePieceFiche"
                style="@style/Texte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                app:drawableStartCompat="@drawable/ic_lieu"
                app:drawableTint="@color/vert_texte"
                tools:text="4 rue de la Paix, 67300 Schiltigheim" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
