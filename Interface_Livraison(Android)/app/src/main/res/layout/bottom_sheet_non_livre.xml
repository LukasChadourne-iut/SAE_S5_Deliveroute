<?xml version="1.0" encoding="utf-8"?>
<!-- Déclaration d’un colis non livré (annexe 2.3, remarque 2) — BottomSheetDialogFragment.
     Le colis reste dans le camion, aucun bon de livraison n’est établi, ses pièces sont
     notées « non livrées » et la commande passera à l’état « partiellement livrée ».
     Les autres colis du même client restent livrables indépendamment. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/blanc"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="20dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_pastille"
            android:backgroundTint="@color/rouge_fond"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_alerte"
            app:tint="@color/rouge_erreur" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Texte.Titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/non_livre_titre" />

            <TextView
                android:id="@+id/tvColisNonLivre"
                style="@style/Texte.Secondaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="COL-044 · Nord Technique · 185 kg" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Texte.Secondaire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/non_livre_sous_titre"
        android:textSize="13sp" />

    <TextView
        style="@style/Texte.Section"
        android:text="@string/motif" />

    <RadioGroup
        android:id="@+id/rgMotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@id/rbMotifAbsent">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbMotifAbsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/motif_absent"
            app:buttonTint="@color/vert_fonce" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbMotifRefus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/motif_refus"
            app:buttonTint="@color/vert_fonce" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/rbMotifAutre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/motif_autre"
            app:buttonTint="@color/vert_fonce" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCommentaireNonLivre"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/commentaire"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/vert_fonce">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCommentaireNonLivre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Affiché si d’autres colis du même client sont dans le camion -->
    <LinearLayout
        android:id="@+id/bandeauAutresColis"
        style="@style/Bandeau"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_colis"
            app:tint="@color/vert_texte" />

        <TextView
            style="@style/Texte.Secondaire"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/autres_colis_client"
            android:textColor="@color/vert_texte" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmerNonLivre"
        style="@style/Bouton.Fonce"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:text="@string/btn_confirmer_non_livre"
        app:backgroundTint="@color/rouge_erreur"
        app:icon="@drawable/ic_croix"
        app:iconTint="@color/blanc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnnulerNonLivre"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/btn_annuler"
        android:textColor="@color/vert_texte" />
</LinearLayout>
