<?xml version="1.0" encoding="utf-8"?>
<!-- Activité principale : en-tête + conteneur de fragments + barre de navigation -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    tools:context=".ui.MainActivity">

    <!-- En-tête : retour (écrans de détail) / logo + salutation + avatar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRetour"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_retour"
            android:src="@drawable/ic_retour"
            android:visibility="gone"
            app:tint="@color/texte"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_logo_tgv" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitreEntete"
                style="@style/Texte.Titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Bonjour Thomas" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/Texte.Secondaire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Jeudi 12 décembre" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cercle"
            android:backgroundTint="@color/avatar_fond"
            android:contentDescription="@string/cd_profil"
            android:gravity="center"
            android:textColor="@color/avatar_texte"
            android:textStyle="bold"
            tools:text="TM" />
    </LinearLayout>

    <!-- Bandeau hors connexion (id racine : bandeauHorsLigne, masqué par défaut).
         Les marges sont redonnées ici car les layout_* de l’include remplacent ceux de la racine. -->
    <include
        layout="@layout/view_bandeau_hors_ligne"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bordureNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bandeauHorsLigne" />

    <!-- Bordure supérieure de la barre de navigation (maquette .mobile-nav) -->
    <View
        android:id="@+id/bordureNav"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/nav_bordure"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/blanc"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/selecteur_nav"
        app:itemTextColor="@color/selecteur_nav"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
