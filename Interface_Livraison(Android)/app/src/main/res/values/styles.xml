<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Textes ===== -->
    <style name="Texte">
        <item name="android:textColor">@color/texte</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Texte.Titre">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.GrandTitre">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.Gras">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texte.Secondaire">
        <item name="android:textColor">@color/texte_secondaire</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Texte.Section">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/texte_secondaire</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Petites infos de la carte « Tournée en cours » (fond foncé) -->
    <style name="Texte.Resume">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="drawableTint">@color/texte_clair</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/texte_clair</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Valeur chiffrée dans les blocs de résultat -->
    <style name="Texte.Valeur">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Conteneurs ===== -->
    <style name="Carte" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/blanc</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gris_bordure</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Carte sélectionnable (choix de l’algorithme d’optimisation) -->
    <style name="Carte.Selectionnable">
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="checkedIconTint">@color/vert_fonce</item>
        <item name="strokeColor">@color/selecteur_bordure_carte</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Badge de statut : la couleur est donnée par backgroundTint + textColor -->
    <style name="Badge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pastille</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Surtitre d’écran (maquette .mobile-title > span : majuscules, gras, espacé) -->
    <style name="Texte.SurTitre">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/surtitre</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Numéro d’ordre (chargement / boucle) : cercle plein, chiffre blanc -->
    <style name="Numero">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_cercle</item>
        <item name="android:backgroundTint">@color/numero_fond</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/blanc</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Ligne cliquable de l’écran « Plus » : icône sur fond arrondi, titre + sous-titre, chevron -->
    <style name="LigneOption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <style name="OptionIcone">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/bg_pastille</item>
        <item name="android:backgroundTint">@color/icone_option_fond</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">8dp</item>
        <item name="tint">@color/icone_option</item>
    </style>

    <style name="OptionTextes">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">12dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="OptionChevron">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_chevron</item>
        <item name="tint">@color/gris_icone</item>
    </style>

    <!-- Séparateur horizontal entre lignes d’une même carte -->
    <style name="Separateur">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/gris_separateur</item>
    </style>

    <!-- Onglets soulignés (maquette .mobile-tabs) -->
    <style name="Onglets" parent="Widget.Material3.TabLayout">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabIndicatorColor">@color/onglet_indicateur</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabRippleColor">@color/gris_separateur</item>
        <item name="tabSelectedTextColor">@color/onglet_actif</item>
        <item name="tabTextColor">@color/onglet_inactif</item>
        <item name="tabTextAppearance">@style/Onglets.Texte</item>
        <item name="tabGravity">fill</item>
        <item name="tabMode">fixed</item>
    </style>

    <style name="Onglets.Texte" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Bandeau d’information vert clair -->
    <style name="Bandeau">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pastille</item>
        <item name="android:backgroundTint">@color/vert_tres_clair</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- ===== Boutons ===== -->
    <style name="Bouton.Principal" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/vert_fonce</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/citron</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/vert_fonce</item>
    </style>

    <style name="Bouton.Fonce" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/blanc</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/vert_fonce</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/citron</item>
    </style>

    <style name="Bouton.Secondaire" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/vert_texte</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/vert_texte</item>
        <item name="strokeColor">@color/gris_bordure</item>
    </style>

    <style name="Bouton.Onglet" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/vert_fonce</item>
        <item name="strokeColor">@color/gris_bordure</item>
    </style>

</resources>
