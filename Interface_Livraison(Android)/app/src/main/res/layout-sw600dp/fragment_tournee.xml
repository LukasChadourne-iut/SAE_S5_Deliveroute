<?xml version="1.0" encoding="utf-8"?>
<!-- Écran « Tournée » (tablette, sw600dp) : carte à gauche, détail de la tournée à droite.
     Mêmes identifiants que la version téléphone pour réutiliser le même Fragment Java. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Carte"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapTournee"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_carte" />

                <TextView
                    android:id="@+id/tvAlgoUtilise"
                    style="@style/Badge"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:backgroundTint="@color/citron"
                    android:text="@string/trajet_optimise"
                    android:textColor="@color/vert_fonce"
                    android:textSize="13sp" />

                <!-- Position du camion en temps réel (MyLocationNewOverlay), sans guidage GPS -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabMaPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="14dp"
                    android:contentDescription="@string/cd_ma_position"
                    android:src="@drawable/ic_ma_position"
                    app:backgroundTint="@color/blanc"
                    app:tint="@color/vert_fonce" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include layout="@layout/view_resume_tournee" />

            <!-- Onglets Itinéraire / Chargement, soulignés (maquette .mobile-tabs).
                 Sélection : tabOnglets.addOnTabSelectedListener (position 0 = Itinéraire, 1 = Chargement). -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="bottom"
                    android:background="@color/onglet_ligne" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabOnglets"
                    style="@style/Onglets"
                    android:layout_width="match_parent"
                    android:layout_height="48dp">

                    <com.google.android.material.tabs.TabItem
                        android:id="@+id/ongletItineraire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onglet_itineraire" />

                    <com.google.android.material.tabs.TabItem
                        android:id="@+id/ongletChargement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/onglet_chargement" />
                </com.google.android.material.tabs.TabLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/bandeauChargement"
                style="@style/Bandeau"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_boite"
                    app:tint="@color/vert_texte" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texte.Gras"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chargement_titre"
                        android:textColor="@color/vert_texte" />

                    <TextView
                        style="@style/Texte.Secondaire"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chargement_aide"
                        android:textColor="@color/vert_texte" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTournee"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/item_arret" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaisirBoucle"
                    style="@style/Bouton.Secondaire"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/btn_saisir_boucle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNavigation"
                    style="@style/Bouton.Principal"
                    android:layout_width="0dp"
                    android:layout_weight="1.3"
                    android:text="@string/btn_navigation"
                    app:icon="@drawable/ic_route" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/view_etat_chargement" />

</FrameLayout>
